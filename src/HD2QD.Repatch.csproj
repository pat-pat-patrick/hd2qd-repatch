<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.Repatch.dll: a plugin of HD2 Mod Quick Deploy, a window of its own (Window.cs).
       It shares no types with the manager: its methods take and give strings, numbers,
       delegates and Json shapes only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2QD.Repatch</AssemblyName>
    <RootNamespace>Hd2Qd.Repatch</RootNamespace>
    <Version>1.2.0</Version>
    <Product>HD2QD Mod Repair</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)\..=src</PathMap>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- the text, one file per language (Lang\<tag>.json), embedded as Lang.<tag>.json: Words.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Repatch.Tests" />
  </ItemGroup>

</Project>
